{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-radar.local/contracts/ai-radar-daily-search.schema.json",
  "title": "AI Radar Daily Search",
  "description": "Contract for a daily AI Radar search snapshot with normalized actionable signals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "generatedAt",
    "query",
    "signals"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "ai-radar-daily-search"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "requestedCount",
        "language",
        "date"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "requestedCount": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "source",
          "evidence",
          "impact",
          "action",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^signal-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "publisher",
              "url",
              "publishedAt"
            ],
            "properties": {
              "publisher": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "publishedAt": {
                "type": "string",
                "format": "date"
              },
              "type": {
                "type": "string",
                "enum": [
                  "fuente_oficial",
                  "repo_tecnico",
                  "comunidad",
                  "medio_secundario"
                ]
              }
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "active",
              "watch",
              "pilot",
              "alert"
            ]
          }
        }
      }
    }
  }
}
